# Copy to .env and edit. Every value is optional in Step 1.
PORT=3000
# Server tick / broadcast interval in ms (spec: 1 Hz or faster)
TICK_MS=500
# Simulated seconds per real second (1 = real time)
TIME_SCALE=60
# Client-side cap so drawn ships never move implausibly fast
MAX_SPEED_KNOTS=30
# Assumed fuel burn, tons per nautical mile
FUEL_TONS_PER_NM=2.5
# Added in later steps:
# ANTHROPIC_API_KEY=
